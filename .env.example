SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,web

# Переменные для образа PostgreSQL (сервис db)
POSTGRES_DB=pythonproject
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Переменные для Django (хост db — имя сервиса в docker-compose)
DB_NAME=pythonproject
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_SUCCESS_URL=http://localhost:8000/swagger/?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/swagger/?payment=cancel

# Redis внутри Docker-сети — имя сервиса redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=noreply@example.com
