SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,web

# PostgreSQL (образ db в docker-compose)
POSTGRES_DB=pythonproject
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Django DB (DB_HOST=db внутри Docker-сети)
DB_NAME=pythonproject
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Stripe
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_SUCCESS_URL=http://localhost/swagger/?payment=success
STRIPE_CANCEL_URL=http://localhost/swagger/?payment=cancel

# Celery / Redis (имя сервиса redis)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=noreply@example.com
